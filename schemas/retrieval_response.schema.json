{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "query",
    "retrieval_query",
    "status",
    "index",
    "config",
    "filters",
    "results",
    "timing_ms",
    "warnings",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": "retrieval_response.v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "query": {
      "type": "string"
    },
    "retrieval_query": {
      "type": "string"
    },
    "status": {
      "enum": [
        "OK",
        "NO_EVIDENCE",
        "ERROR"
      ]
    },
    "index": {
      "type": [
        "object",
        "null"
      ]
    },
    "config": {
      "type": "object"
    },
    "filters": {
      "type": [
        "object",
        "null"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "chunk_id",
          "document_id",
          "chunk_index",
          "text",
          "text_sha256",
          "scores",
          "retrieved_by",
          "citation"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "chunk_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "chunk_index": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "distance",
              "similarity",
              "bm25",
              "rrf",
              "rerank"
            ],
            "properties": {
              "distance": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "similarity": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "bm25": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "rrf": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "rerank": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "retrieved_by": {
            "type": "array",
            "items": {
              "enum": [
                "dense"
              ]
            },
            "minItems": 1
          },
          "citation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "title",
              "published_at_utc",
              "source_name",
              "source_domain"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "published_at_utc": {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              "source_name": {
                "type": "string",
                "minLength": 1
              },
              "source_domain": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "timing_ms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encode",
        "search",
        "rerank",
        "total"
      ],
      "properties": {
        "encode": {
          "type": "number",
          "minimum": 0
        },
        "search": {
          "type": "number",
          "minimum": 0
        },
        "rerank": {
          "type": "number",
          "minimum": 0
        },
        "total": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "OK"
          }
        }
      },
      "then": {
        "properties": {
          "results": {
            "minItems": 1
          },
          "error": {
            "type": "null"
          },
          "query": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "NO_EVIDENCE"
          }
        }
      },
      "then": {
        "properties": {
          "results": {
            "maxItems": 0
          },
          "error": {
            "type": "null"
          },
          "query": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ERROR"
          }
        }
      },
      "then": {
        "properties": {
          "results": {
            "maxItems": 0
          },
          "error": {
            "type": "object"
          }
        }
      }
    }
  ]
}
