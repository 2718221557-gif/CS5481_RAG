{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "documents.schema.json",
  "title": "news_documents.v1",
  "type": "object",
  "required": [
    "schema_version",
    "document_id",
    "source_name",
    "source_domain",
    "source_tier",
    "url",
    "title",
    "body_text",
    "published_at_utc",
    "language",
    "word_count",
    "content_sha256",
    "fetched_at_utc",
    "metadata"
  ],
  "properties": {
    "schema_version": {"const": "news_documents.v1"},
    "document_id": {"type": "string", "minLength": 1},
    "source_name": {"type": "string"},
    "source_domain": {"type": "string"},
    "source_tier": {"type": "string"},
    "url": {"type": "string", "format": "uri"},
    "api_url": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "standfirst": {"type": "string"},
    "byline": {"type": "string"},
    "section_id": {"type": "string"},
    "section_name": {"type": "string"},
    "content_type": {"type": "string"},
    "published_at_utc": {"type": "string", "format": "date-time"},
    "first_seen_at_utc": {"type": "string", "format": "date-time"},
    "fetched_at_utc": {"type": "string", "format": "date-time"},
    "language": {"type": "string"},
    "word_count": {"type": "integer", "minimum": 1},
    "body_text": {"type": "string", "minLength": 1},
    "body_html": {"type": "string"},
    "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
